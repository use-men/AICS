# SmartDesk 环境变量配置示例

# ---- 基础配置 ----
APP_NAME=SmartDesk
DEBUG=true
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/smartdesk
JWT_SECRET_KEY=your_jwt_secret_here
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---- Web Search (Tavily) ----
# 申请地址: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# ---- 阿里云 OSS ----
# 控制台: https://oss.console.aliyun.com
OSS_ACCESS_KEY_ID=your_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_access_key_secret_here
OSS_BUCKET_NAME=your_bucket_name_here
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
